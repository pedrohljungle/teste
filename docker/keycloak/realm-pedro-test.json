{
  "realm": "pedro-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "app-admin",
        "description": "Papel exigido pelas rotas /admin da API"
      }
    ]
  },
  "clients": [
    {
      "clientId": "pedro-test-api",
      "name": "pedro-test API",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "audience-pedro-test-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pedro-test-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "pedro-test-worker",
      "name": "pedro-test worker (service account)",
      "enabled": true,
      "publicClient": false,
      "secret": "worker-secret-local",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-pedro-test-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pedro-test-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "pedro",
      "enabled": true,
      "emailVerified": true,
      "email": "pedro@example.com",
      "firstName": "Pedro",
      "lastName": "Teste",
      "credentials": [
        {
          "type": "password",
          "value": "pedro",
          "temporary": false
        }
      ],
      "realmRoles": ["app-admin"]
    },
    {
      "username": "joana",
      "enabled": true,
      "emailVerified": true,
      "email": "joana@example.com",
      "firstName": "Joana",
      "lastName": "Teste",
      "credentials": [
        {
          "type": "password",
          "value": "joana",
          "temporary": false
        }
      ]
    }
  ]
}
