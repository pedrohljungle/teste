{
  "realm": "pedro-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "app-admin",
        "description": "Papel exigido pelas rotas /admin da API"
      },
      {
        "name": "internal_service",
        "description": "Servico interno: unico autorizado a abrir carteiras, ler carteiras e o ledger e reconciliar"
      },
      {
        "name": "provider",
        "description": "Provedor de jogos: envia operacoes e le apenas as proprias transacoes"
      }
    ]
  },
  "clients": [
    {
      "clientId": "pedro-test-api",
      "name": "pedro-test API",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "audience-pedro-test-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pedro-test-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "pedro-test-worker",
      "name": "pedro-test worker (service account)",
      "enabled": true,
      "publicClient": false,
      "secret": "worker-secret-local",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-pedro-test-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pedro-test-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "pedro-test-wallet-service",
      "name": "pedro-test wallet service (internal)",
      "enabled": true,
      "publicClient": false,
      "secret": "wallet-service-secret-local",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-pedro-test-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pedro-test-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-a",
      "name": "Game provider A",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-a-secret-local",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-pedro-test-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pedro-test-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Game provider B",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-b-secret-local",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-pedro-test-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pedro-test-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "pedro-test-short-lived",
      "name": "Internal service with one-second tokens (tests only)",
      "enabled": true,
      "publicClient": false,
      "secret": "short-lived-secret-local",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-pedro-test-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pedro-test-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "access.token.lifespan": "1"
      }
    }
  ],
  "users": [
    {
      "username": "pedro",
      "enabled": true,
      "emailVerified": true,
      "email": "pedro@example.com",
      "firstName": "Pedro",
      "lastName": "Teste",
      "credentials": [
        {
          "type": "password",
          "value": "pedro",
          "temporary": false
        }
      ],
      "realmRoles": [
        "app-admin"
      ]
    },
    {
      "username": "joana",
      "enabled": true,
      "emailVerified": true,
      "email": "joana@example.com",
      "firstName": "Joana",
      "lastName": "Teste",
      "credentials": [
        {
          "type": "password",
          "value": "joana",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-pedro-test-wallet-service",
      "enabled": true,
      "serviceAccountClientId": "pedro-test-wallet-service",
      "realmRoles": [
        "internal_service"
      ]
    },
    {
      "username": "service-account-provider-a",
      "enabled": true,
      "serviceAccountClientId": "provider-a",
      "realmRoles": [
        "provider"
      ]
    },
    {
      "username": "service-account-provider-b",
      "enabled": true,
      "serviceAccountClientId": "provider-b",
      "realmRoles": [
        "provider"
      ]
    },
    {
      "username": "service-account-pedro-test-short-lived",
      "enabled": true,
      "serviceAccountClientId": "pedro-test-short-lived",
      "realmRoles": [
        "internal_service"
      ]
    }
  ]
}
