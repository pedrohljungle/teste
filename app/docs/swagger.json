{
    "swagger": "2.0",
    "info": {
        "description": "Tarefas criadas pela API e concluídas por um worker.",
        "title": "pedro-test",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "description": "Aberta de propósito, para um orquestrador sem token conseguir perguntar. Diz também qual aplicação e versão respondeu.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "operations"
                ],
                "summary": "Liveness",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/health.Status"
                        }
                    }
                }
            }
        },
        "/me": {
            "get": {
                "security": [
                    {
                        "OAuth2Password": []
                    }
                ],
                "description": "Devolve quem chamou, como o realm descreveu: subject, username, e-mail e papéis.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "identity"
                ],
                "summary": "Quem sou eu",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/structs.Principal"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/structs.APIError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "health.Status": {
            "type": "object",
            "properties": {
                "role": {
                    "type": "string",
                    "example": "server"
                },
                "service": {
                    "type": "string",
                    "example": "pedro-test-server"
                },
                "status": {
                    "type": "string",
                    "example": "ok"
                },
                "version": {
                    "type": "string",
                    "example": "1.4.0"
                }
            }
        },
        "structs.APIError": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "invalid token"
                }
            }
        },
        "structs.Principal": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "roles": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "sub": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "OAuth2Password": {
            "type": "oauth2",
            "flow": "password",
            "tokenUrl": "http://localhost:8080/realms/pedro-test/protocol/openid-connect/token",
            "scopes": {
                "openid": "Acesso à API"
            }
        }
    }
}