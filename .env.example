# Copy to .env and adjust. Never commit .env.

APP_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/pedro_test?sslmode=disable
# Redis backs the listing cache. The job queue lives in SQS.
REDIS_URL=redis://localhost:6379/0

# --- Keycloak -----------------------------------------------------------------------------
# Issuer is the external realm address, the one written into the token iss claim.
KEYCLOAK_ISSUER=http://localhost:8080/realms/pedro-test
# Set only when the application reaches Keycloak through a different address than the token
# issuer, which is what happens inside Compose or Kubernetes.
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_AUDIENCE=pedro-test-api
# Worker only: it authenticates as a machine with client_credentials.
KEYCLOAK_CLIENT_ID=pedro-test-worker
KEYCLOAK_CLIENT_SECRET=worker-secret-local

# --- Queue (SQS) --------------------------------------------------------------------------
AWS_REGION=us-east-1
# Only outside AWS: points the SDK at the local emulator. Empty in every real environment.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/pedro-test-tasks
# The FIFO queue the outbox publisher sends the integration events to.
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# SQS long polling wait, capped at 20s by the service.
WORKER_POLL_TIMEOUT=20s
# Must exceed the slowest handler, otherwise a running message is delivered again.
WORKER_VISIBILITY_TIMEOUT=60
WORKER_CONCURRENCY=4

# --- Outbox publisher ---------------------------------------------------------------------
# How often the publisher looks for due events when the last look found none. A look that finds
# work is followed by another at once.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=25
# How long a claimed event stays reserved for its publisher. When the publisher dies holding it,
# another one takes it over once this runs out. It must exceed the time to publish a batch.
OUTBOX_LEASE=60s
# Wait before an event that failed to publish is tried again: the base doubled on every attempt,
# up to the maximum. An event is never given up on.
OUTBOX_BACKOFF_BASE=1s
OUTBOX_BACKOFF_MAX=5m

# --- OpenTelemetry ------------------------------------------------------------------------
# host:port of the OTLP gRPC endpoint. Empty turns exporting off without changing any
# instrumented code path, which is what lets tests and local runs skip the backend.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0
# Com que frequência as métricas são empurradas. O padrão do SDK é 60s.
OTEL_METRIC_EXPORT_INTERVAL=15s

# --- API docs ----------------------------------------------------------------------------
# Registers /docs and /openapi.json. Off by default: in production the routes do not exist.
DOCS_ENABLED=true

# --- goose --------------------------------------------------------------------------------
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/pedro_test?sslmode=disable
GOOSE_MIGRATION_DIR=migrations

# Optional: overrides the password in DATABASE_URL. Used where the secret is injected on its
# own, such as an ECS task reading it from Secrets Manager.
DATABASE_PASSWORD=
